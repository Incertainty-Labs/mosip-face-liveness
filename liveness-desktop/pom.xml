<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mosip.registration.liveness</groupId>
        <artifactId>mosip-face-liveness</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>liveness-desktop</artifactId>
    <name>liveness-desktop</name>
    <description>Desktop adapters for the Registration Client: MJPEG and webcam frame sources, ISO face decoding, JavaFX liveness overlay.</description>

    <properties>
        <!-- The Desktop Registration Client on master runs on a Zulu 11 FX JRE (MOSIP: base changes on master). -->
        <maven.compiler.release>11</maven.compiler.release>
        <!-- The overlay runs inside the client's own JavaFX 11, so it compiles against 11 and never ships JavaFX. -->
        <javafx.version>11.0.2</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mosip.registration.liveness</groupId>
            <artifactId>liveness-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
